# Copia este archivo como .env y pega los valores (el .env no se sube al repo).
# De la "Blob SAS URL" de lectura:
#   https://<cuenta>.blob.core.windows.net/planificacion?sp=r&st=...&sig=...
# lo que va ANTES del "?" es BLOB_URL y lo que va DESPUÉS es BLOB_SAS.
NUXT_PUBLIC_BLOB_URL=
NUXT_PUBLIC_BLOB_SAS=

# Ya no se usa (era la API FastAPI); se deja vacío para los mocks locales.
# NUXT_PUBLIC_API_BASE=

# Inicio de sesión. Vacíos = modo demo (sin login).
# Google Cloud Console → Credentials → OAuth client ID (Web).
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
# Azure → App registrations → Application (client) ID.
NUXT_PUBLIC_MS_CLIENT_ID=
# common = personales + empresas · organizations = solo empresas · <tenant-id> = solo Teletón
NUXT_PUBLIC_MS_TENANT=common
# Vacío = cualquier correo. Ej. futuro: teleton.cl
NUXT_PUBLIC_DOMINIOS_PERMITIDOS=

# Guardar parámetros (SOLO servidor: sin NUXT_PUBLIC_, nunca llegan al navegador).
# SAS con Create + Write (la misma de Blue Prism), lo que va DESPUÉS del "?" (sp=cw&st=...&sig=...).
NUXT_BLOB_SAS_ESCRITURA=
# Clave que pide la pantalla Parámetros para guardar. Vacía = no pide clave.
NUXT_PARAMETROS_CLAVE=
